# ==========================================
# NINETY - LIVE SCORE WIDGET CONFIGURATION
# ==========================================

# Select your preferred data provider
# Options: "API-FOOTBALL" | "FOOTBALL-DATA"
VITE_DATA_PROVIDER="API-FOOTBALL"

# ------------------------------------------
# PROVIDER 1: API-Football (api-sports.io)
# ------------------------------------------
# - Best for: True Live Scores, Events, Lineups
# - Free Tier Limit: 100 requests / day
VITE_API_FOOTBALL_KEY="your_api_football_key_here"

# ------------------------------------------
# PROVIDER 2: football-data.org
# ------------------------------------------
# - Best for: High frequency polling, zero rate limit worries
# - Free Tier Limit: 10 requests / minute
# - Note: Live scores are delayed on the free tier.
VITE_FOOTBALL_DATA_KEY="your_football_data_key_here"
